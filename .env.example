# Copy to .env and fill in real values. Never commit the real .env file.
#
# Shorter than it was. Most of what used to be here - a Postgres password, an
# Airflow Fernet key and secret key, admin credentials, a bcrypt hash for the
# basic auth in front of the Airflow UI, two hostnames - configured a Docker
# Compose stack on an EC2 box that was deleted on 13 October 2026. The pipeline
# runs on GitHub Actions now and the API runs as one container, so the only
# values left are the three upstream services the pipeline itself talks to.
#
# In production these are GitHub Actions repository secrets, not a file.

# Free-tier signup at console.groq.com. Without this, the digest task still runs -
# it just writes the prompt it would have sent instead of a real LLM response.
GROQ_API_KEY=

# Official MyAnimeList API v2 client id. Free, from https://myanimelist.net/apiconfig
# Optional: fetch_mal skips cleanly when this is unset.
MAL_CLIENT_ID=

# An ntfy.sh topic to push a run that fails its own checks to. Optional: unset,
# the run still fails, but nobody is told. An unguessable topic name is the only
# protection ntfy.sh topics have, so treat it as a secret.
NTFY_TOPIC=

# --- Serving -----------------------------------------------------------------
#
# The API reads these from its environment, not from this file - they are set in
# the host's dashboard (see render.yaml). Listed here because a local run of the
# API uses the same names.
#
# WAREHOUSE_REPO    owner/repo to fetch the published warehouse from. UNSET means
#                   "read DATA_DIR/warehouse.duckdb as it is", which is what a
#                   local run after a local pipeline run wants.
# GITHUB_TOKEN      fine-grained, Contents: read, that repository only. Required
#                   while the repository is private. GitHub caps these at a year.
# ALLOWED_ORIGINS   comma-separated browser origins allowed to call the API.
#                   /search is fetched from the browser, so an origin missing
#                   here is a search box that fails.
# DATA_DIR          where the warehouse lives. Defaults to /data.
