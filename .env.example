# Copy to .env and fill in real values. Never commit the real .env file.

SERVER_HOST=your.server.ip.or.domain

POSTGRES_PASSWORD=

# Generate with:
#   docker run --rm apache/airflow:2.10.4-python3.12 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Generate with: openssl rand -hex 30
AIRFLOW_SECRET_KEY=

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_ADMIN_EMAIL=you@example.com
