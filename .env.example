# Copy to .env and fill in real values. Never commit the real .env file.

SERVER_HOST=your.server.ip.or.domain
AIRFLOW_HOST=airflow.your.server.ip.or.domain

POSTGRES_PASSWORD=

# Generate with:
#   docker run --rm apache/airflow:2.10.4-python3.12 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Generate with: openssl rand -hex 30
AIRFLOW_SECRET_KEY=

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_ADMIN_EMAIL=you@example.com

# Free-tier signup at console.groq.com. Without this, the digest task still runs -
# it just writes the prompt it would have sent instead of a real LLM response.
GROQ_API_KEY=

# Official MyAnimeList API v2 client id. Free, from https://myanimelist.net/apiconfig
# Optional: fetch_mal skips cleanly when this is unset.
MAL_CLIENT_ID=
