# Secrets / keys
*.pem
*.key
.env
.env.*
!.env.example

# Internal working notes (contains infra IPs, instance IDs, key paths)
PROGRESS.md

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node / frontend
node_modules/
dist/
build/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
# .terraform.lock.hcl is deliberately NOT ignored - it should be committed to pin
# provider versions for reproducible plans/applies. terraform.tfvars.example isn't
# matched by *.tfvars above (that only matches files ending in exactly .tfvars).

