# Secrets / keys
*.pem
*.key
.env
.env.*
!.env.example

# Internal working notes (contain infra IPs, instance IDs, key paths - no secret
# values, but more detail than belongs in a public repo)
PROGRESS.md
HANDOFF.md

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node / frontend
node_modules/
dist/
build/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
# .terraform.lock.hcl is deliberately NOT ignored - it should be committed to pin
# provider versions for reproducible plans/applies. terraform.tfvars.example isn't
# matched by *.tfvars above (that only matches files ending in exactly .tfvars).

# Data
*.parquet
*.duckdb
data/
caddy-logs/

# OS / editor
.DS_Store
.vscode/
.idea/

# Agent tool state (not project code). Work here alternates between Claude Code
# and Codex, and each keeps its own config, cache and memory beside the repo.
.claude/
.serena/

# Screenshots and traces from browser verification, by either agent
.playwright-mcp/
output/
schedule-*.png

# Playwright smoke-test output (frontend/e2e)
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

