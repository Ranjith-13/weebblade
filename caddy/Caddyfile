# weebblade.duckdns.org (free DuckDNS subdomain, points at the EC2 IP) - giving
# Caddy a real hostname instead of ":80" is the entire HTTPS setup: it requests and
# renews a real Let's Encrypt cert automatically and redirects HTTP -> HTTPS on its
# own, no extra config needed. Consider splitting Airflow/API onto subdomains
# instead of the /airflow path-prefix hack at some point - a cleaner setup than
# base_url proxying, just not required for HTTPS itself.
weebblade.duckdns.org {
	# Cheap defense-in-depth, applies to every response regardless of route. No CSP
	# here deliberately - Airflow's own UI (proxied at /airflow) loads its own
	# inline scripts/styles, and a strict CSP written for our JSON API would break
	# it; revisit if/when Airflow gets split onto its own subdomain.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	# Structured per-request access log to a file (not just container stdout) so
	# fail2ban on the host can tail it and ban IPs making abusive request volumes -
	# a second layer below the app-level rate limiting (slowapi), at the firewall
	# instead of inside the app. Caddy handles its own rotation here.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}

	handle /airflow* {
		reverse_proxy airflow-webserver:8080
	}

	handle {
		reverse_proxy backend:8000
	}
}
