# weebblade.duckdns.org + weebblade-airflow.duckdns.org (both free DuckDNS
# subdomains, both point at the same EC2 IP) - giving Caddy real hostnames instead
# of ":80" is the entire HTTPS setup: it requests and renews a real Let's Encrypt
# cert per hostname automatically and redirects HTTP -> HTTPS on its own, no extra
# config needed. Split onto separate subdomains (was previously a /airflow
# path-prefix on the same domain) so each service gets a CSP suited to it, and so
# Airflow's BASE_URL doesn't need path-rewriting quirks Caddy's handle_path/handle
# had to work around before.
weebblade.duckdns.org {
	# Strict-ish defaults for our own JSON API - safe now that Airflow's UI (which
	# needs its own inline scripts/styles) lives on its own subdomain instead of
	# sharing this one.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	# Structured per-request access log to a file (not just container stdout) so
	# fail2ban on the host can tail it and ban IPs making abusive request volumes -
	# a second layer below the app-level rate limiting (slowapi), at the firewall
	# instead of inside the app. Caddy handles its own rotation here.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}

	reverse_proxy backend:8000
}

weebblade-airflow.duckdns.org {
	# Airflow's own login was the only thing between the internet and a system
	# whose entire purpose is running arbitrary code. This puts a second,
	# independent gate in front of it, so Airflow's pre-authentication surface -
	# every endpoint a CVE would target before login - is no longer reachable by
	# anything that has not already authenticated here.
	#
	# The hash comes from the environment, never from this file: a bcrypt hash is
	# not a secret worth much, but it is still a credential and the repo is not
	# where it belongs. Set AIRFLOW_BASIC_AUTH_HASH in .env (docker-compose passes
	# it through), generating it with:
	#
	#   docker compose exec caddy caddy hash-password
	#
	# No default here on purpose. Caddy's `{$VAR:default}` only applies when a
	# variable is UNSET, and compose passes an empty one - which Caddy rejects
	# ("username and password cannot be empty"), refusing to start and taking the
	# public API down with it, since one Caddy serves both hostnames. Shipping
	# that is what proved it. The guaranteed-valid fallback therefore lives in
	# docker-compose.yml, which can substitute on empty as well as unset.
	basic_auth {
		{$AIRFLOW_BASIC_AUTH_USER} {$AIRFLOW_BASIC_AUTH_HASH}
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	log {
		output file /var/log/caddy/access-airflow.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}

	reverse_proxy airflow-webserver:8080
}
